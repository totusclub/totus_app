# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

$FirebaseSDKVersion = '12.10.0'
# Avoid FBLPromises shadowed-module errors with RNFB
$RNFirebaseAsStaticFramework = true

# React Native 0.79's New Architecture crashes in Hermes during startup on
# iOS 26. Use the stable bridge until React Native is upgraded.
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Static frameworks required for React Native Firebase Swift pods
linkage = ENV['USE_FRAMEWORKS'] || 'static'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym

target 'totusClubApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true

  # Prefer local WebRTC if present (avoids re-downloading ~199MB)
  jitsi_local = File.expand_path('../.pod-src/JitsiWebRTC-pod', __dir__)
  if File.directory?(File.join(jitsi_local, 'WebRTC.xcframework'))
    pod 'JitsiWebRTC', :path => jitsi_local
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    # The codegen script treats the parent of the ios folder as the app root.
    # The Xcode copy lives in ~/Developer/totus-open, so that parent has no
    # package.json. Point the script at this repository instead.
    app_root = File.expand_path('..', __dir__)
    installer.pods_project.targets.each do |target|
      target.shell_script_build_phases.each do |phase|
        script = phase.shell_script
        next unless script&.include?('RCT_SCRIPT_APP_PATH=')
        phase.shell_script = script.sub(
          'RCT_SCRIPT_APP_PATH="$RCT_SCRIPT_POD_INSTALLATION_ROOT/.."',
          %(RCT_SCRIPT_APP_PATH="#{app_root}")
        )
      end
    end

    # Xcode 27 rejects deployment targets below 15.0. Privacy bundles keep the
    # older version from their podspec unless it is raised here.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current.nil? || current.to_f < 15.0
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
      end
    end

    # fmt 11.0.2's consteval format checks fail on Xcode 16.3 and later.
    # C++17 turns those checks off. The headers are installed read-only.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'fmt'
      target.build_configurations.each do |config|
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      end
    end
    Dir.glob(File.join(installer.sandbox.root, 'Target Support Files', 'fmt', 'fmt.*.xcconfig')).each do |xcconfig|
      contents = File.read(xcconfig)
      patched = contents.gsub('CLANG_CXX_LANGUAGE_STANDARD = c++20', 'CLANG_CXX_LANGUAGE_STANDARD = c++17')
      File.write(xcconfig, patched) if patched != contents
    end

    # Support-file groups sit inside each pod's source group, so their paths are
    # relative to node_modules. Opened from another directory, that walks up to
    # Developer/ios/Pods and the xcconfig files are missing. Anchor them on the
    # Pods project instead.
    installer.pods_project.main_group.recursive_children.each do |object|
      next unless object.respond_to?(:path) && object.respond_to?(:source_tree)
      path = object.path
      next unless path&.include?('Target Support Files/')
      relative = path.split('Target Support Files/', 2).last
      object.path = "Target Support Files/#{relative}"
      object.source_tree = 'SOURCE_ROOT'
    end

    # Static umbrella Pods_*.framework is linked as -lPods-* (looks for .a) and fails.
    # Individual pods are already linked via OTHER_LDFLAGS in the Pods xcconfig.
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.native_targets.each do |native_target|
        native_target.frameworks_build_phase.files.to_a.each do |build_file|
          name = build_file.display_name
          next unless name&.end_with?('.framework') && name.start_with?('Pods_')
          native_target.frameworks_build_phase.remove_file_reference(build_file.file_ref)
        end
      end
      aggregate_target.user_project.save
    end
  end
end
